      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 3
                },
                "conditions": [
                  {
                    "id": "90f75e0f-cd56-4756-9c9a-30f81b2bc944",
                    "leftValue": "={{ [$json.subject, $json.text, $json.snippet].filter(Boolean).join(' ').toLowerCase() }}",
                    "rightValue": "=\\b(urgent|hitno|asap|immediately|odmah|important|deadline|rok je|time.sensitive)\\b",
                    "operator": {
                      "type": "string",
                      "operation": "contains"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "=Urgent"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 3
                },
                "conditions": [
                  {
                    "id": "63f8a744-6364-4abf-a69a-6a686a20928c",
                    "leftValue": "={{ [$json.subject, $json.text, $json.snippet].filter(Boolean).join(' ').toLowerCase() }}",
                    "rightValue": "=\\b(invoice|faktura|racun|račun|predračun|profaktura|payment\\s*due|billing|receipt|uplata|iznos za uplatu)\\b",
                    "operator": {
                      "type": "string",
                      "operation": "regex"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Invoice"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 3
                },
                "conditions": [
                  {
                    "id": "95ca3a13-b608-4388-9b49-61b0bfea12dd",
                    "leftValue": "={{ [$json.subject, $json.text, $json.snippet].filter(Boolean).join(' ').toLowerCase() }}",
                    "rightValue": "=\\b(lead|upit|ponuda|inquiry|quote|interested in|demo|pricing|saradnj|kontakt forma)\\b",
                    "operator": {
                      "type": "string",
                      "operation": "contains"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "=Lead"
            }
          ]
        },
